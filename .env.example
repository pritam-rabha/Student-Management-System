# Copy this file to .env for local development. Never commit .env.

# development enables the debugger-free dev server defaults; production enforces SECRET_KEY
# and secure cookies (requires HTTPS).
APP_ENV=development

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cedb489c28f44902efac301b24dfbf95ec8800f1d5f536f165a9bc42fbfdcc41

# Administrator account. Generate the hash with: python scripts/create_admin_hash.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='pbkdf2:sha256:1000000$OOV2dBnFZfDIWOly$5aace780ab2ab6defde8c71a610a4a34dbcd18c71c9f5db4df997dae4c8da95a'

# Optional alternative for quick local trials only (hashed in memory at startup).
# Ignored when ADMIN_PASSWORD_HASH is set.
# ADMIN_PASSWORD=

# Storage. Defaults to ./data. On Render's free plan this directory is ephemeral.
# DATA_DIR=data
# Load demonstration data only when no data file exists yet.
SEED_SAMPLE_DATA=true

# Set to true behind a reverse proxy such as Render so client addresses are read correctly.
TRUST_PROXY=false

# Login throttling.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_SECONDS=300

# Local server port (Render sets PORT automatically).
# PORT=5000
